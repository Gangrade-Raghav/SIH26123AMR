<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="amr_lidar" params="
    prefix
    laser_x:=0.22
    laser_y:=0.0
    laser_z:=0.18
  ">

    <joint name="${prefix}laser_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}laser_frame"/>
      <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}laser_frame">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.04"/>
        </geometry>
        <material name="amr_blue"/>
      </visual>

      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.04"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0"
          izz="0.0001"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
