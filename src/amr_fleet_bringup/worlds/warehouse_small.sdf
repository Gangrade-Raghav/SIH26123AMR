<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="warehouse_small">

    <!-- Physics Configuration -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins for Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun / Ambient Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (16m x 16m floor) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Boundary Walls (16m x 16m interior, centered at 8, 8) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>8 16 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16.4 0.4 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>16.4 0.4 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>8 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16.4 0.4 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>16.4 0.4 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>16 8 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 16.4 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 16.4 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 8 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 16.4 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 16.4 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Storage Racks (Obstacles matching config/maps/warehouse_grid_small.yaml) -->
    <model name="rack_1">
      <static>true</static>
      <pose>4.5 5.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_2">
      <static>true</static>
      <pose>4.5 10.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_3">
      <static>true</static>
      <pose>11.5 5.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_4">
      <static>true</static>
      <pose>11.5 10.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
